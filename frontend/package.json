{
    "name": "logistics-frontend",
    "version": "0.1.0",
    "private": true,
    "description": "Next.js frontend for Smart Logistics Platform",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
        "lint": "eslint . --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "test": "jest"
    },
    "overrides": {
        "postcss": "$postcss"
    },
    "dependencies": {
        "next": "^15.5.28",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "socket.io-client": "^4.7.5"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.1",
        "eslint-config-next": "^15.5.28",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.3.0",
        "postcss": "^8.5.30",
        "prettier": "^3.3.3",
        "tailwindcss": "^3.4.10",
        "ts-jest": "^29.4.6",
        "typescript": "^5.5.4"
    }
}
