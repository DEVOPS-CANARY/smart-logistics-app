DATABASE_URL=postgres://logistics:logistics@localhost:5432/logistics
JWT_SECRET=change-me-in-local-dev
ALLOWED_ORIGINS=http://localhost:3000
JWT_ISSUER=
JWT_AUDIENCE=
PORT=3001
# Optional. In the cluster, every backend replica shares WebSocket events and
# rate limits through Redis. Unset = kept in this process (one replica only).
REDIS_URL=
REDIS_KEY_PREFIX=
# Optional. In the cluster, tracking updates are published to Kafka for other
# services (the notification worker: `node dist/worker.js`). Unset = not published.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC_PREFIX=
# Worker only: simulated time to send one notification (ms).
NOTIFY_DELAY_MS=0
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
